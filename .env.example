# =============================================================================
# Quarkus Dev Mode – local environment variables
# This file is read automatically by `mvn quarkus:dev`.
# Copy to .env and adjust to your local setup (do NOT commit credentials).
# =============================================================================

# ---------------------------------------------------------------------------
# Container runtime – Docker or Podman
#
# Docker (default):
#   No configuration needed – Testcontainers finds /var/run/docker.sock automatically.
#
# Rootless Podman (most common Linux setup):
#   1. Enable the socket once:
#        systemctl --user enable --now podman.socket
#   2. Uncomment the line below and replace <UID> with your user ID (`id -u`):
# ---------------------------------------------------------------------------
#DOCKER_HOST=unix:///run/user/<UID>/podman/podman.sock

# Rootful Podman (socket at the same path as Docker – no extra config needed):
#DOCKER_HOST=unix:///var/run/docker.sock

# ---------------------------------------------------------------------------
# Cloud providers (all disabled by default – override per environment)
# ---------------------------------------------------------------------------
#AWS_ENABLED=false
#AZURE_ENABLED=false
#GCP_ENABLED=false

