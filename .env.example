# =============================================================================
# Green Software Champions – local settings
#
# Copy to .env (git-ignored) and uncomment what you need. Quarkus reads .env
# from the working directory at startup, in dev mode and for the packaged app.
# Every line is commented out, so copying the file as it is changes nothing:
# dev mode keeps its sample data, Keycloak Dev Service and ./data/greensoft.
# Keep comments on their own lines and don't quote values. Quarkus reads this
# file like a properties file, so quotes and trailing "# ..." become part of
# the value. All settings: README, "Configuration".
# =============================================================================

# --- Dev mode ----------------------------------------------------------------

# Enforce login and roles like in production
# (Keycloak Dev Service users: developer/developer, admin/admin)
#QUARKUS_SECURITY_AUTH_ENABLED_IN_DEV_MODE=true

# Your own teams file instead of the sample teams
#QUARKUS_CONFIG_LOCATIONS=/absolute/path/to/my-teams.yaml

# DOCKER_HOST, e.g. for Podman, doesn't work here: export it instead
# (README, "Using Podman")

# --- AWS ---------------------------------------------------------------------
# Enabling any provider stops the sample data. Run `rm -rf data` first.
#AWS_ENABLED=true
#AWS_REGION=us-east-1
# Leave both unset to use the AWS SDK's default credentials chain (profiles,
# SSO, IAM role). Needs sustainability:GetEstimatedCarbonEmissions.
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
# Assign your AWS accounts to teams in your own teams file, see
# QUARKUS_CONFIG_LOCATIONS above and README, "Teams file"

# --- GCP (under development) -------------------------------------------------
#GCP_ENABLED=true
# Service account key: a file path, or the JSON itself (takes precedence)
#CLOUD_GCP_CREDENTIALS_FILE=/path/to/service-account.json
#CLOUD_GCP_CREDENTIALS_JSON=

# --- Azure (under development) -----------------------------------------------
#AZURE_ENABLED=true
#CLOUD_AZURE_TENANT_ID=
#CLOUD_AZURE_CLIENT_ID=
#CLOUD_AZURE_CLIENT_SECRET=

# --- Sync & history ----------------------------------------------------------
# Quartz cron, server time zone
#CARBON_SYNC_CRON=0 0 2 25 * ?
#CARBON_SYNC_MONTHS=12
#CARBON_HISTORY_MONTHS=13

# --- Packaged application (required outside dev mode) ------------------------
#TEAMS_FILE=/etc/green-champions/teams.yaml
# H2 file without .mv.db, absolute or starting with ./ or ~/
# (dev mode also uses this, instead of ./data/greensoft)
#DB_FILE=/var/lib/green-software-champions/data
#OIDC_ISSUER_URL=https://keycloak.example.com/realms/green-software
#OIDC_CLIENT_SECRET=

# --- Identity provider and proxy (optional) ----------------------------------
# Ignored in dev mode, which always uses green-champions
#OIDC_CLIENT_ID=green-champions

# The following also apply in dev mode, so leave them unset there.
# Required token audience, if other applications get tokens from the same issuer
#OIDC_AUDIENCE=
# Entra ID, Okta org server, Auth0: read the roles from the ID token
#QUARKUS_OIDC_ROLES_SOURCE=idtoken
# Behind a reverse proxy
#QUARKUS_HTTP_PROXY_PROXY_ADDRESS_FORWARDING=true
#QUARKUS_HTTP_PROXY_ENABLE_FORWARDED_HOST=true
